# Copier vers .env à la racine avant `docker compose up`.
# Ne pas committer .env.

POSTGRES_USER=miambook
POSTGRES_PASSWORD=miambook
POSTGRES_DB=miambookv2_db

# Origine vue par le navigateur. Sur le Raspberry Pi, ajoute l'adresse réelle,
# par exemple http://192.168.1.20 ou http://miambook.local
CORS_ORIGINS=http://localhost

HTTP_PORT=80

# Clés RS256. Depuis backend/ : npm run auth:generate-keys
# Colle la sortie ici, guillemets compris, les retours à la ligne en \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
