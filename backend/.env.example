# =============================================================================
# MBV2 Backend — variables d'environnement
# Copier ce fichier :  copy .env.example .env
# =============================================================================

# Port HTTP de l'API (défaut : 3333)
PORT=3333

# -----------------------------------------------------------------------------
# PostgreSQL (Supabase)
# Renseigner UNE des deux méthodes ci-dessous.
# -----------------------------------------------------------------------------

# --- Méthode A (recommandée) : champs séparés ---
# Supabase → Project Settings → Database → Host / Port / Database
DB_HOST=db.VOTRE_PROJECT_REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REMPLACE_PAR_TON_MOT_DE_PASSE_SUPABASE
DB_NAME=postgres
DB_SSL=true

# --- Méthode B (alternative) : URI complète ---
# Si tu utilises DATABASE_URL, mets le mot de passe dans l'URI
# OU laisse DB_PASSWORD ci-dessus (prioritaire sur l'URI).
# DATABASE_URL=postgresql://postgres:TON_MOT_DE_PASSE@db.VOTRE_PROJECT_REF.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Supabase Storage (upload images recettes)
# Supabase → Project Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REMPLACE_PAR_TA_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=recipe-images

# -----------------------------------------------------------------------------
# JWT (auth) — optionnel en dev
# Sans ces clés, des clés éphémères sont générées à chaque redémarrage
# (les tokens deviennent invalides). Pour des clés stables :
#   npm run auth:generate-keys
# puis coller la sortie ici.
# -----------------------------------------------------------------------------
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
