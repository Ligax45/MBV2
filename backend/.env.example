# =============================================================================
# MBV2 Backend — variables d'environnement
# Copier ce fichier :  cp .env.example .env
# =============================================================================

# Port HTTP de l'API (défaut : 3333)
PORT=3333

# Origines CORS autorisées (séparées par des virgules). Requis pour cookies.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Cookies auth (httpOnly). Path=/api pour le proxy Angular/nginx.
COOKIE_PATH=/api
# COOKIE_SECURE=true en HTTPS ; false en HTTP local.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# PostgreSQL local
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=miambook
DB_PASSWORD=miambook
DB_NAME=miambookv2_db
DB_SSL=false

# Alternative : URI complète (DB_PASSWORD reste prioritaire s'il est renseigné).
# DATABASE_URL=postgresql://miambook:miambook@localhost:5432/miambookv2_db

# Répertoire des photos de recettes (hors de la base).
# RECIPE_IMAGES_DIR=data/recipe-images

# true dans Docker : applique les migrations MikroORM au démarrage.
# RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# JWT (auth) — obligatoire en production (NODE_ENV=production)
# En dev, sans ces clés, des clés éphémères sont générées à chaque redémarrage
# (les tokens deviennent invalides). Pour des clés stables :
#   npm run auth:generate-keys
# puis coller la sortie ici.
# -----------------------------------------------------------------------------
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
